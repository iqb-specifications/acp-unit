{
  "name": "@iqbspecs/acp-unit",
  "author": "IQB - Institut zur Qualitätsentwicklung im Bildungswesen",
  "license": "CC0-1.0",
  "description": "Specification for assessment content package: Unit.",
  "scripts": {
    "validate-schema": "test-schema test acp-unit.schema.json",
    "async_generate": "ag ./make_doc/asyncapi.yaml @asyncapi/html-template --param config=make_doc/asyncapi.config.json -o ./public --force-write",
    "test_docs_windows": "node_modules\\.bin\\asyncapi-generator ./make_doc/asyncapi.yaml @asyncapi/html-template --param config=make_doc/asyncapi.config.json -o ./public --force-write",
    "generate_docs": "npm run async_generate && cat make_doc/add.css >> ./public/css/global.min.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iqb-specifications/acp-unit.git"
  },
  "bugs": {
    "url": "https://github.com/iqb-specifications/acp-unit/issues"
  },
  "homepage": "https://github.com/iqb-specifications/acp-unit#readme",
  "devDependencies": {
    "@iqbspecs/validate-json": "^0.4.0",
    "@asyncapi/generator": "2.4.1",
    "@asyncapi/html-template": "3.1.0"
  }
}
